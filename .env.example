MONGODB_URI=mongodb://127.0.0.1:27017/tabibi
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
AUTH_TRUSTED_ORIGINS=
REDIS_URL=redis://127.0.0.1:6379

# Google Gmail SMTP (use an App Password or the supported OAuth configuration).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Doctor auth link destinations (frontend routes that receive the token).
DOCTOR_EMAIL_VERIFICATION_URL=http://localhost:3000/verify-doctor-email
DOCTOR_MAGIC_LINK_URL=http://localhost:3000/auth/doctor/magic-link/consume

# Bootstrap account created by `npm run seed:super-admin`.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=Tabibi Super Admin
SUPER_ADMIN_PASSWORD=
